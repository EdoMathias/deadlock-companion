# PostHog analytics configuration (loaded at build time by webpack via dotenv).
# Copy this file to `.env` and fill in your key. `.env` is gitignored.
#
# POSTHOG_KEY is the PUBLIC/publishable PostHog project key (starts with "phc_").
# It is safe to ship in client code. Leave it empty to build WITHOUT analytics
# (the app runs normally, telemetry just no-ops).
#
# Tip: use a separate PostHog project/key for dev vs. production.

POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
